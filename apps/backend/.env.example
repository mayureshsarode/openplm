# Backend Environment Variables
# Copy to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://openplm:openplm@localhost:5432/openplm

# JWT (in production, must be at least 32 characters and non-default)
JWT_SECRET=dev-secret-change-in-production-1234567890
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=debug
