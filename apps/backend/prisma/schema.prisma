// OpenPLM — Prisma Schema
// Engineering Product Lifecycle & Change Intelligence Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════════

enum RoleName {
  ADMIN
  ENGINEER
  REVIEWER
  VIEWER
}

enum ProductRevisionStatus {
  DRAFT
  PROTOTYPING
  IN_REVIEW
  APPROVED
  RELEASED
  DEPRECATED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RequirementRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASED
  DEPRECATED
}

enum DependencyRelationshipType {
  DEPENDS_ON
  PART_OF
  IMPLEMENTS
  TESTS
  DOCUMENTS
}

enum ChangePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  IMPACT_ANALYSIS
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
  VERIFIED
  RELEASED
}

enum ImpactAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ImpactType {
  DIRECT
  INDIRECT
  TRACEABILITY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStateType {
  INITIAL
  INTERMEDIATE
  TERMINAL
}

enum WorkflowTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum DocumentRevisionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  RELEASED
  DEPRECATED
}

// ═══════════════════════════════════════════════════════════════════════════════
// 1. Identity Models
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar
  passwordHash String   @map("password_hash") @db.VarChar
  firstName    String   @map("first_name") @db.VarChar
  lastName     String   @map("last_name") @db.VarChar
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  userRoles                  UserRole[]
  createdProducts            Product[]             @relation("ProductCreatedBy")
  createdProductRevisions    ProductRevision[]     @relation("ProductRevisionCreatedBy")
  createdComponents          Component[]           @relation("ComponentCreatedBy")
  createdComponentRevisions  ComponentRevision[]   @relation("ComponentRevisionCreatedBy")
  createdBoms                Bom[]                 @relation("BomCreatedBy")
  createdRequirements        Requirement[]         @relation("RequirementCreatedBy")
  createdRequirementRevisions RequirementRevision[] @relation("RequirementRevisionCreatedBy")
  createdDependencies        Dependency[]          @relation("DependencyCreatedBy")
  requestedChangeRequests    ChangeRequest[]       @relation("ChangeRequestRequestedBy")
  assignedWorkflowTasks      WorkflowTask[]        @relation("WorkflowTaskAssignedTo")
  createdDocuments           Document[]            @relation("DocumentCreatedBy")
  createdDocumentRevisions   DocumentRevision[]    @relation("DocumentRevisionCreatedBy")
  auditEvents                AuditEvent[]          @relation("AuditEventActor")

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        RoleName  @unique
  description String?   @db.VarChar
  permissions String[]
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 2. Product Models
// ═══════════════════════════════════════════════════════════════════════════════

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  productNumber String   @unique @map("product_number") @db.VarChar
  name          String   @db.VarChar
  description   String?  @db.Text
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator   User?             @relation("ProductCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revisions ProductRevision[]

  @@index([productNumber], map: "idx_products_product_number")
  @@map("products")
}

model ProductRevision {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @map("product_id") @db.Uuid
  revisionNumber Int                   @map("revision_number")
  displayCode    String                @map("display_code") @db.VarChar
  status         ProductRevisionStatus @default(DRAFT)
  description    String?               @db.Text
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  product          Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator          User?                    @relation("ProductRevisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  bom              Bom?
  requirementLinks RequirementProductLink[]

  @@unique([productId, revisionNumber])
  @@index([productId, revisionNumber], map: "idx_product_revisions_product_id")
  @@map("product_revisions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 3. Component Models
// ═══════════════════════════════════════════════════════════════════════════════

model Component {
  id              String   @id @default(uuid()) @db.Uuid
  componentNumber String   @unique @map("component_number") @db.VarChar
  name            String   @db.VarChar
  type            String?  @db.VarChar
  description     String?  @db.Text
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator   User?               @relation("ComponentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revisions ComponentRevision[]

  @@index([componentNumber], map: "idx_components_component_number")
  @@map("components")
}

model ComponentRevision {
  id             String                @id @default(uuid()) @db.Uuid
  componentId    String                @map("component_id") @db.Uuid
  revisionNumber Int                   @map("revision_number")
  displayCode    String                @map("display_code") @db.VarChar
  status         ProductRevisionStatus @default(DRAFT)
  description    String?               @db.Text
  createdBy      String?               @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  component        Component                  @relation(fields: [componentId], references: [id], onDelete: Restrict)
  creator          User?                      @relation("ComponentRevisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  bomItems         BomItem[]
  requirementLinks RequirementComponentLink[]

  @@unique([componentId, revisionNumber])
  @@index([componentId, revisionNumber], map: "idx_component_revisions_component_id")
  @@map("component_revisions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 4. BOM Models
// ═══════════════════════════════════════════════════════════════════════════════

model Bom {
  id                String   @id @default(uuid()) @db.Uuid
  productRevisionId String   @unique @map("product_revision_id") @db.Uuid
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  productRevision ProductRevision @relation(fields: [productRevisionId], references: [id], onDelete: Restrict)
  creator         User?           @relation("BomCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  items           BomItem[]

  @@map("boms")
}

model BomItem {
  id                  String   @id @default(uuid()) @db.Uuid
  bomId               String   @map("bom_id") @db.Uuid
  componentRevisionId String   @map("component_revision_id") @db.Uuid
  parentBomItemId     String?  @map("parent_bom_item_id") @db.Uuid
  quantity            Int      // DB constraint: CHECK ("quantity" > 0)
  position            Int?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bom               Bom               @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentRevision ComponentRevision @relation(fields: [componentRevisionId], references: [id], onDelete: Restrict)
  parentBomItem     BomItem?          @relation("BomItemHierarchy", fields: [parentBomItemId], references: [id], onDelete: Cascade)
  children          BomItem[]         @relation("BomItemHierarchy")

  @@index([bomId], map: "idx_bom_items_bom_id")
  @@index([parentBomItemId], map: "idx_bom_items_parent")
  @@index([componentRevisionId], map: "idx_bom_items_component_revision")
  @@map("bom_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 5. Requirements Models
// ═══════════════════════════════════════════════════════════════════════════════

model Requirement {
  id                String               @id @default(uuid()) @db.Uuid
  requirementNumber String               @unique @map("requirement_number") @db.VarChar
  title             String               @db.VarChar
  priority          RequirementPriority?
  createdBy         String?              @map("created_by") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator   User?                 @relation("RequirementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revisions RequirementRevision[]

  @@map("requirements")
}

model RequirementRevision {
  id             String                    @id @default(uuid()) @db.Uuid
  requirementId  String                    @map("requirement_id") @db.Uuid
  revisionNumber Int                       @map("revision_number")
  displayCode    String                    @map("display_code") @db.VarChar
  content        String                    @db.Text
  status         RequirementRevisionStatus @default(DRAFT)
  createdBy      String?                   @map("created_by") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  requirement    Requirement                @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  creator        User?                      @relation("RequirementRevisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  productLinks   RequirementProductLink[]
  componentLinks RequirementComponentLink[]

  @@unique([requirementId, revisionNumber])
  @@index([requirementId, revisionNumber], map: "idx_requirement_revisions_requirement_id")
  @@map("requirement_revisions")
}

model RequirementProductLink {
  requirementRevisionId String   @map("requirement_revision_id") @db.Uuid
  productRevisionId     String   @map("product_revision_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  requirementRevision RequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Cascade)
  productRevision     ProductRevision     @relation(fields: [productRevisionId], references: [id], onDelete: Cascade)

  @@id([requirementRevisionId, productRevisionId])
  @@map("requirement_product_links")
}

model RequirementComponentLink {
  requirementRevisionId String   @map("requirement_revision_id") @db.Uuid
  componentRevisionId   String   @map("component_revision_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  requirementRevision RequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Cascade)
  componentRevision   ComponentRevision   @relation(fields: [componentRevisionId], references: [id], onDelete: Cascade)

  @@id([requirementRevisionId, componentRevisionId])
  @@map("requirement_component_links")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 6. Dependency Model (Polymorphic)
// ═══════════════════════════════════════════════════════════════════════════════

model Dependency {
  id               String                     @id @default(uuid()) @db.Uuid
  sourceType       String                     @map("source_type") @db.VarChar
  sourceId         String                     @map("source_id") @db.Uuid
  targetType       String                     @map("target_type") @db.VarChar
  targetId         String                     @map("target_id") @db.Uuid
  relationshipType DependencyRelationshipType @map("relationship_type")
  metadata         Json?
  createdBy        String?                    @map("created_by") @db.Uuid
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  creator User? @relation("DependencyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, targetType, targetId, relationshipType])
  @@map("dependencies")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 7. Change Management Models
// ═══════════════════════════════════════════════════════════════════════════════

model ChangeRequest {
  id           String              @id @default(uuid()) @db.Uuid
  changeNumber String              @unique @map("change_number") @db.VarChar
  title        String              @db.VarChar
  description  String?             @db.Text
  reason       String?             @db.Text
  priority     ChangePriority?
  status       ChangeRequestStatus @default(DRAFT)
  requestedBy  String?             @map("requested_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  requester      User?            @relation("ChangeRequestRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  changeItems    ChangeItem[]
  impactAnalyses ImpactAnalysis[]

  @@index([changeNumber], map: "idx_change_requests_number")
  @@index([status], map: "idx_change_requests_status")
  @@map("change_requests")
}

model ChangeItem {
  id              String   @id @default(uuid()) @db.Uuid
  changeRequestId String   @map("change_request_id") @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar
  entityId        String   @map("entity_id") @db.Uuid
  fromRevisionId  String?  @map("from_revision_id") @db.Uuid
  toRevisionId    String?  @map("to_revision_id") @db.Uuid
  description     String?  @db.VarChar
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId], map: "idx_change_items_cr_id")
  @@map("change_items")
}

model ImpactAnalysis {
  id               String               @id @default(uuid()) @db.Uuid
  changeRequestId  String               @map("change_request_id") @db.Uuid
  version          Int
  status           ImpactAnalysisStatus @default(PENDING)
  algorithmVersion String               @map("algorithm_version") @db.VarChar
  startedAt        DateTime?            @map("started_at") @db.Timestamptz
  completedAt      DateTime?            @map("completed_at") @db.Timestamptz
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz

  changeRequest ChangeRequest  @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  results       ImpactResult[]

  @@index([changeRequestId], map: "idx_impact_analyses_cr_id")
  @@map("impact_analyses")
}

model ImpactResult {
  id               String      @id @default(uuid()) @db.Uuid
  impactAnalysisId String      @map("impact_analysis_id") @db.Uuid
  entityType       String      @map("entity_type") @db.VarChar
  entityId         String      @map("entity_id") @db.Uuid
  entityName       String?     @map("entity_name") @db.VarChar
  impactType       ImpactType  @map("impact_type")
  depth            Int?
  riskLevel        RiskLevel?  @map("risk_level")
  details          Json?
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz

  impactAnalysis ImpactAnalysis @relation(fields: [impactAnalysisId], references: [id], onDelete: Cascade)

  @@index([impactAnalysisId], map: "idx_impact_results_analysis_id")
  @@map("impact_results")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 8. Workflow Models
// ═══════════════════════════════════════════════════════════════════════════════

model WorkflowDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar
  description String?  @db.VarChar
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  states      WorkflowState[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@map("workflow_definitions")
}

model WorkflowState {
  id                   String            @id @default(uuid()) @db.Uuid
  workflowDefinitionId String            @map("workflow_definition_id") @db.Uuid
  name                 String            @db.VarChar
  stateType            WorkflowStateType @map("state_type")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz

  workflowDefinition  WorkflowDefinition   @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  outgoingTransitions WorkflowTransition[] @relation("WorkflowTransitionFrom")
  incomingTransitions WorkflowTransition[] @relation("WorkflowTransitionTo")
  currentInstances    WorkflowInstance[]

  @@map("workflow_states")
}

model WorkflowTransition {
  id                   String   @id @default(uuid()) @db.Uuid
  workflowDefinitionId String   @map("workflow_definition_id") @db.Uuid
  fromStateId          String   @map("from_state_id") @db.Uuid
  toStateId            String   @map("to_state_id") @db.Uuid
  name                 String?  @db.VarChar
  requiredPermission   String?  @map("required_permission") @db.VarChar
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  fromState          WorkflowState      @relation("WorkflowTransitionFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toState            WorkflowState      @relation("WorkflowTransitionTo", fields: [toStateId], references: [id], onDelete: Restrict)

  @@map("workflow_transitions")
}

model WorkflowInstance {
  id                   String    @id @default(uuid()) @db.Uuid
  workflowDefinitionId String    @map("workflow_definition_id") @db.Uuid
  currentStateId       String    @map("current_state_id") @db.Uuid
  entityType           String    @map("entity_type") @db.VarChar
  entityId             String    @map("entity_id") @db.Uuid
  startedAt            DateTime  @map("started_at") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  currentState       WorkflowState      @relation(fields: [currentStateId], references: [id], onDelete: Restrict)
  tasks              WorkflowTask[]

  @@map("workflow_instances")
}

model WorkflowTask {
  id                 String             @id @default(uuid()) @db.Uuid
  workflowInstanceId String             @map("workflow_instance_id") @db.Uuid
  assignedTo         String             @map("assigned_to") @db.Uuid
  taskType           String             @map("task_type") @db.VarChar
  status             WorkflowTaskStatus @default(PENDING)
  description        String?            @db.VarChar
  dueDate            DateTime?          @map("due_date") @db.Timestamptz
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz

  workflowInstance WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  assignee         User             @relation("WorkflowTaskAssignedTo", fields: [assignedTo], references: [id], onDelete: Restrict)

  @@index([assignedTo, status], map: "idx_workflow_tasks_assigned")
  @@map("workflow_tasks")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 9. Document Models
// ═══════════════════════════════════════════════════════════════════════════════

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  documentNumber String   @unique @map("document_number") @db.VarChar
  title          String   @db.VarChar
  type           String?  @db.VarChar
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator   User?              @relation("DocumentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  revisions DocumentRevision[]

  @@map("documents")
}

model DocumentRevision {
  id             String                 @id @default(uuid()) @db.Uuid
  documentId     String                 @map("document_id") @db.Uuid
  revisionNumber Int                    @map("revision_number")
  displayCode    String                 @map("display_code") @db.VarChar
  status         DocumentRevisionStatus @default(DRAFT)
  content        String?                @db.Text
  createdBy      String?                @map("created_by") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  creator  User?    @relation("DocumentRevisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([documentId, revisionNumber])
  @@map("document_revisions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// 10. Audit Model
// ═══════════════════════════════════════════════════════════════════════════════

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar
  entityType    String   @map("entity_type") @db.VarChar
  entityId      String   @map("entity_id") @db.Uuid
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId], map: "idx_audit_events_entity")
  @@index([createdAt], map: "idx_audit_events_created")
  @@map("audit_events")
}
